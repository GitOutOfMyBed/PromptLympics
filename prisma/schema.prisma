generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String              @id @default(cuid())
  name                 String?
  email                String              @unique
  emailVerified        DateTime?
  image                String?
  password             String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  accounts             Account[]
  competitions         Competition[]
  sessions             Session[]
  submissions          Submission[]
  practiceChallenges   PracticeChallenge[]
  practiceSubmissions  PracticeSubmission[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Competition {
  id                 String            @id @default(cuid())
  title              String
  description        String
  organizationName   String
  totalPrize         Float
  firstPlacePrize    Float?
  secondPlacePrize   Float?
  thirdPlacePrize    Float?
  prizeDistribution  PrizeDistribution @default(WINNER_TAKES_ALL)
  minimumScore              Float?
  targetScore               Float?
  maxSubmissionsPerUser     Int               @default(3)  // Maximum number of submissions per participant
  starterPrompt             String?
  characterLimit            Int?
  tokenLimit                Int?
  customModelUrl     String?
  trainingDataUrl    String            // Public download URL for training data
  validationDataUrl  String            // Private storage path (not a URL - accessed via Admin SDK)
  trainingDataSize   Int
  validationDataSize Int
  startDate          DateTime
  endDate            DateTime
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  status             CompetitionStatus @default(DRAFT)
  bestScore          Float?
  bestSubmissionId   String?
  organizerId        String
  modelType          String

  // API Key configuration (encrypted)
  encryptedApiKey    String
  apiKeyProvider     String            // "openai", "anthropic", or "google"

  organizer          User              @relation(fields: [organizerId], references: [id])
  submissions        Submission[]
}

model Submission {
  id            String           @id @default(cuid())
  competitionId String
  userId        String
  prompt        String
  score         Float?           // Accuracy score (indexed for leaderboard performance)
  evaluationLog String?          // JSON array of test case results (organizer view only)
  status        SubmissionStatus @default(PENDING)
  errorMessage  String?
  submittedAt   DateTime         @default(now())
  evaluatedAt   DateTime?
  competition   Competition      @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([competitionId, score])
  @@index([userId])
}

enum CompetitionStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PrizeDistribution {
  WINNER_TAKES_ALL
  TOP_THREE
  THRESHOLD_BASED
}

enum SubmissionStatus {
  PENDING
  EVALUATING
  COMPLETED
  FAILED
}

model PracticeChallenge {
  id                    String               @id @default(cuid())
  title                 String
  description           String
  organizationName      String
  minimumScore          Float?
  targetScore           Float?
  maxSubmissionsPerUser Int                  @default(999) // High limit for practice - essentially unlimited
  starterPrompt         String?
  characterLimit        Int?
  tokenLimit            Int?
  trainingDataUrl       String               // Public download URL for training data
  validationDataUrl     String               // Private storage path (not a URL - accessed via Admin SDK)
  trainingDataSize      Int
  validationDataSize    Int
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  bestScore             Float?
  bestSubmissionId      String?
  creatorId             String
  modelType             String

  // API Key configuration (encrypted)
  encryptedApiKey       String
  apiKeyProvider        String               // "openai", "anthropic", or "google"

  creator               User                 @relation(fields: [creatorId], references: [id])
  submissions           PracticeSubmission[]
}

model PracticeSubmission {
  id                  String           @id @default(cuid())
  practiceChallengeId String
  userId              String
  prompt              String
  score               Float?           // Accuracy score (indexed for leaderboard performance)
  evaluationLog       String?          // JSON array of test case results (user can see their own)
  status              SubmissionStatus @default(PENDING)
  errorMessage        String?
  submittedAt         DateTime         @default(now())
  evaluatedAt         DateTime?
  practiceChallenge   PracticeChallenge @relation(fields: [practiceChallengeId], references: [id], onDelete: Cascade)
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([practiceChallengeId, score])
  @@index([userId])
}
