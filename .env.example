# Database
DATABASE_URL="postgresql://user:password@localhost:5432/promptlympics?schema=public"

# Firebase Admin SDK (for server-side storage access)
# Get this from Firebase Console > Project Settings > Service Accounts > Generate New Private Key
# Paste the entire JSON content from the downloaded file as a single-line string
# Format: Entire JSON including curly braces, wrapped in single quotes
# Example: FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'
FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com"}'

# Firebase Auth is configured in firebase/firebasefrontend.js
# No environment variables needed - uses public key verification for serverless

# URL to neon database
DATABASE_URL=""

# API Key Encryption
# Generate with: openssl rand -hex 32
API_KEY_ENCRYPTION_SECRET=""
