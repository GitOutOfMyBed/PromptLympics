# Database
DATABASE_URL="postgresql://user:password@localhost:5432/promptlympics?schema=public"

# Firebase Admin SDK (for server-side storage access)
# Get this from Firebase Console > Project Settings > Service Accounts > Generate New Private Key
# Download the JSON file and place it in your project root (it will be gitignored)
# Set this to the path of your service account JSON file
FIREBASE_SERVICE_ACCOUNT_KEY="./your-firebase-adminsdk-file.json"

# Firebase Auth is configured in firebase/firebasefrontend.js
# No environment variables needed - uses public key verification for serverless

# OpenAI (for prompt evaluation)
OPENAI_API_KEY=""

# Anthropic (for prompt evaluation)
ANTHROPIC_API_KEY=""

# Google AI (for prompt evaluation with Gemini models)
GOOGLE_GENERATIVE_AI_API_KEY=""

# API Key Encryption
# Generate with: openssl rand -hex 32
API_KEY_ENCRYPTION_SECRET=""

# File upload
MAX_FILE_SIZE=10485760  # 10MB in bytes
UPLOAD_DIR="./uploads"
